---
import Layout from "../../layouts/Layout.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import Logo from "../../components/Logo.astro";
import AuthHero from "../../components/AuthHero.astro";
import 密码Input from "../../components/密码Input.astro";

if (Astro.cookies.get("candlr_token")?.value) {
  return Astro.redirect("/");
}

const { token } = Astro.params;
---

<Layout title="重置密码">
  <div class="min-h-dvh grid md:grid-cols-2">
    <AuthHero />

    <div class="relative flex items-center justify-center px-4 py-16">
      <div class="fixed top-4 right-4 z-20">
        <ThemeToggle class="p-2 rounded-lg bg-surface dark:bg-surface-dark border" />
      </div>

      <div class="w-full max-w-[360px]">
        <div class="mb-8">
          <div class="md:hidden mb-4">
            <Logo size="md" />
          </div>
          <h1 class="text-lg font-semibold tracking-tight">Choose a new password</h1>
        </div>

        <div class="card p-6 space-y-4" id="form-card">
          <div id="error-msg" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg"></div>
          <div>
            <label class="label" for="new-password">新密码</label>
            <密码Input id="new-password" autocomplete="new-password" placeholder="••••••••" />
          </div>
          <div>
            <label class="label" for="confirm-password">确认新密码</label>
            <密码Input id="confirm-password" autocomplete="new-password" placeholder="••••••••" />
          </div>
          <button id="submit-btn" class="btn-primary w-full mt-1">重置密码</button>
        </div>

        <div class="card p-6 hidden" id="success-card">
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-3">您的密码已更新。</p>
          <a href="/login" class="btn-primary inline-block">登录</a>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ token }}>
    const btn = document.getElementById("submit-btn");
    const errEl = document.getElementById("error-msg");
    const formCard = document.getElementById("form-card");
    const successCard = document.getElementById("success-card");

    async function submit() {
      const new密码 = document.getElementById("new-password").value;
      const confirm密码 = document.getElementById("confirm-password").value;

      errEl.classList.add("hidden");
      if (!new密码 || !confirm密码) return;
      if (new密码 !== confirm密码) {
        errEl.textContent = "两次密码不一致";
        errEl.classList.remove("hidden");
        return;
      }

      btn.disabled = true;
      btn.textContent = "Resetting…";

      try {
        const res = await fetch(`/api/auth/reset-password/${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ new_password: new密码 }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not reset password";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        formCard.classList.add("hidden");
        successCard.classList.remove("hidden");
      } catch (e) {
        errEl.textContent = e.message;
        errEl.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "重置密码";
      }
    }

    btn.addEventListener("click", submit);
    ["new-password", "confirm-password"].forEach((id) => {
      document.getElementById(id)?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") submit();
      });
    });
  </script>
</Layout>
