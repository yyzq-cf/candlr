---
import Layout from "../layouts/Layout.astro";
import 密码Input from "../components/密码Input.astro";
import { apiJson, isUnauthorized, backendUnavailable } from "../lib/api";

const cookies = Astro.request.headers.get("cookie") ?? "";

let meFailure: unknown = null;
const meResult = await apiJson<{ username: string; is_admin: boolean }>("/auth/me", { cookies }).catch((e) => {
  meFailure = e;
  return null;
});
if (!meResult) {
  if (!isUnauthorized(meFailure)) return backendUnavailable();
  Astro.cookies.delete("candlr_token", { path: "/" });
  return Astro.redirect("/login");
}
if (!meResult.is_admin) {
  return Astro.redirect("/");
}

type 管理User = {
  id: number;
  username: string;
  email: string;
  is_admin: boolean;
  has_password: boolean;
  created_at: string;
};

const users = (await apiJson<管理User[]>("/settings/users", { cookies }).catch(() => [] as 管理User[])).sort(
  (a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
);
---

<Layout title="管理" user={{ username: meResult.username, is_admin: true }} activePage="admin">
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-10 space-y-6">
    <div>
      <h1 class="text-lg font-semibold tracking-tight">管理</h1>
    </div>

    <section class="card p-6 pb-0">
      <h2 class="text-sm font-medium mb-4">Users</h2>
      <div class="-mx-6">
        <table class="w-full table-fixed text-sm">
          <thead>
            <tr class="text-left text-xs text-zinc-600 dark:text-zinc-300 border-b">
              <th class="font-medium px-6 py-2">User</th>
              <th class="w-20 font-medium px-3 py-2">Role</th>
              <th class="w-14 font-medium px-3 py-2 text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody id="users-body">
            {users.map((u) => (
              <tr class="border-b last:border-0" data-user-row={u.id}>
                <td class="min-w-0 px-6 py-3 align-top">
                  <div class="font-medium">{u.username}</div>
                  <div class="mt-0.5 text-xs text-zinc-600 dark:text-zinc-300 [overflow-wrap:anywhere]">{u.email}</div>
                </td>
                <td class="px-3 py-3 align-middle">
                  <span
                    data-role-badge
                    class:list={[
                      "inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium",
                      u.is_admin
                        ? "bg-accent/10 text-accent dark:bg-accent-light/10 dark:text-accent-light"
                        : "bg-zinc-100 text-zinc-500 dark:bg-white/5 dark:text-zinc-400",
                    ]}
                  >
                    {u.is_admin ? "管理" : "User"}
                  </span>
                </td>
                <td class="px-3 py-3 text-right align-top">
                  {u.username !== meResult.username && (
                    <div class="relative inline-block text-left" data-user-actions>
                      <button
                        type="button"
                        class="user-actions-btn icon-button btn-ghost p-1.5"
                        aria-label={`Actions for ${u.username}`}
                        aria-haspopup="menu"
                        aria-expanded="false"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <circle cx="12" cy="5" r="1.75" />
                          <circle cx="12" cy="12" r="1.75" />
                          <circle cx="12" cy="19" r="1.75" />
                        </svg>
                      </button>
                      <div class="user-actions-menu hidden absolute right-0 top-full z-20 mt-1 w-40 py-1 card shadow-lg" role="menu">
                        <button
                          type="button"
                          role="menuitem"
                          class="toggle-admin-btn flex w-full px-3 py-2 text-left text-sm text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-white/5 transition-colors"
                          data-user-id={u.id}
                          data-is-admin={String(u.is_admin)}
                        >
                          {u.is_admin ? "Remove admin" : "Make admin"}
                        </button>
                        <button
                          type="button"
                          role="menuitem"
                          class="delete-user-btn flex w-full px-3 py-2 text-left text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors"
                          data-user-id={u.id}
                          data-username={u.username}
                        >
                          删除
                        </button>
                      </div>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card p-6">
      <details class="group">
        <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <span class="text-sm font-medium">Add user</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="pt-4">
          <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
            Creates an account directly. This bypasses the registration-enabled and max-users settings.
          </p>
          <div id="add-user-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
          <div class="space-y-3 max-w-sm">
            <div>
              <label class="label" for="new-user-username">用户名</label>
              <input id="new-user-username" class="input" type="text" autocomplete="off" />
            </div>
            <div>
              <label class="label" for="new-user-email">邮箱</label>
              <input id="new-user-email" class="input" type="email" autocomplete="off" />
            </div>
            <div>
              <label class="label" for="new-user-password">密码</label>
              <密码Input id="new-user-password" autocomplete="new-password" />
            </div>
            <button id="add-user-btn" type="button" class="btn-primary">Add user</button>
          </div>
        </div>
      </details>
    </section>
  </main>

  <div id="delete-user-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div id="delete-user-modal-backdrop" class="absolute inset-0 bg-black/40"></div>
    <div class="relative card p-6 w-full max-w-sm">
      <h2 class="text-base font-semibold mb-1.5">删除 <span id="delete-user-name"></span>?</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        This permanently deletes their account and all of their data. This cannot be undone.
      </p>
      <div class="flex gap-2 justify-end">
        <button id="delete-user-cancel-btn" type="button" class="btn-secondary">取消</button>
        <button id="delete-user-confirm-btn" type="button"
          class="text-sm font-medium px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors">
          删除
        </button>
      </div>
    </div>
  </div>

  <script>
    import { showToast } from "../lib/toast.js";

    // ── Add user ──
    const usersBody = document.getElementById("users-body")!;
    const addUserError = document.getElementById("add-user-error")!;
    const addUserBtn = document.getElementById("add-user-btn") as HTMLButtonElement;
    const new用户名Input = document.getElementById("new-user-username") as HTMLInputElement;
    const new邮箱Input = document.getElementById("new-user-email") as HTMLInputElement;
    const new密码Input = document.getElementById("new-user-password") as HTMLInputElement;

    function userRowHtml(u: { id: number; username: string; email: string }) {
      const username = document.createElement("div");
      username.textContent = u.username;
      const email = document.createElement("div");
      email.textContent = u.email;
      return `
        <tr class="border-b last:border-0" data-user-row="${u.id}">
          <td class="min-w-0 px-6 py-3 align-top">
            <div class="font-medium">${username.innerHTML}</div>
            <div class="mt-0.5 text-xs text-zinc-600 dark:text-zinc-300 [overflow-wrap:anywhere]">${email.innerHTML}</div>
          </td>
          <td class="px-3 py-3 align-middle">
            <span data-role-badge class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-zinc-100 text-zinc-500 dark:bg-white/5 dark:text-zinc-400">User</span>
          </td>
          <td class="px-3 py-3 text-right align-top">
            <div class="relative inline-block text-left" data-user-actions>
              <button type="button" class="user-actions-btn icon-button btn-ghost p-1.5" aria-label="Actions for ${username.innerHTML}" aria-haspopup="menu" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <circle cx="12" cy="5" r="1.75"></circle>
                  <circle cx="12" cy="12" r="1.75"></circle>
                  <circle cx="12" cy="19" r="1.75"></circle>
                </svg>
              </button>
              <div class="user-actions-menu hidden absolute right-0 top-full z-20 mt-1 w-40 py-1 card shadow-lg" role="menu">
                <button type="button" role="menuitem" class="toggle-admin-btn flex w-full px-3 py-2 text-left text-sm text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-white/5 transition-colors" data-user-id="${u.id}" data-is-admin="false">Make admin</button>
                <button type="button" role="menuitem" class="delete-user-btn flex w-full px-3 py-2 text-left text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" data-user-id="${u.id}" data-username="${username.innerHTML}">删除</button>
              </div>
            </div>
          </td>
        </tr>`;
    }

    function closeUserActionMenus() {
      usersBody.querySelectorAll<HTMLElement>(".user-actions-menu").forEach((menu) => menu.classList.add("hidden"));
      usersBody.querySelectorAll<HTMLButtonElement>(".user-actions-btn").forEach((btn) => {
        btn.setAttribute("aria-expanded", "false");
      });
    }

    usersBody.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".user-actions-btn") as HTMLButtonElement | null;
      if (!btn) return;
      const menu = btn.closest("[data-user-actions]")?.querySelector<HTMLElement>(".user-actions-menu");
      if (!menu) return;
      const willOpen = menu.classList.contains("hidden");
      closeUserActionMenus();
      if (willOpen) {
        menu.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
      }
    });

    document.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest(".user-actions-btn")) closeUserActionMenus();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const openBtn = usersBody.querySelector<HTMLButtonElement>('.user-actions-btn[aria-expanded="true"]');
      closeUserActionMenus();
      openBtn?.focus();
    });

    addUserBtn?.addEventListener("click", async () => {
      const username = new用户名Input.value.trim();
      const email = new邮箱Input.value.trim();
      const password = new密码Input.value;

      addUserError.classList.add("hidden");
      if (!username || !email || !password) {
        addUserError.textContent = "Fill in all fields";
        addUserError.classList.remove("hidden");
        return;
      }

      addUserBtn.disabled = true;
      try {
        const res = await fetch("/api/settings/users", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, email, password }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not add user";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        const created = await res.json();
        usersBody.insertAdjacentHTML("beforeend", userRowHtml(created));
        new用户名Input.value = "";
        new邮箱Input.value = "";
        new密码Input.value = "";
      } catch (e: any) {
        addUserError.textContent = e.message;
        addUserError.classList.remove("hidden");
      } finally {
        addUserBtn.disabled = false;
      }
    });

    document.getElementById("users-body")?.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest(".toggle-admin-btn") as HTMLButtonElement | null;
      if (!btn) return;
      const userId = btn.dataset.userId;
      const make管理 = btn.dataset.is管理 !== "true";

      btn.disabled = true;
      try {
        const res = await fetch(`/api/settings/users/${userId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ is_admin: make管理 }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not update user";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }

        const row = btn.closest("tr");
        const badge = row?.querySelector("[data-role-badge]");
        if (badge) {
          badge.textContent = make管理 ? "管理" : "User";
          badge.className = [
            "inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium",
            make管理
              ? "bg-accent/10 text-accent dark:bg-accent-light/10 dark:text-accent-light"
              : "bg-zinc-100 text-zinc-500 dark:bg-white/5 dark:text-zinc-400",
          ].join(" ");
        }
        btn.textContent = make管理 ? "Remove admin" : "Make admin";
        btn.dataset.is管理 = String(make管理);
      } catch (err: any) {
        showToast(err.message ?? "Could not update user", "error");
      } finally {
        btn.disabled = false;
      }
    });

    // ── Delete user ──
    const deleteUserModal = document.getElementById("delete-user-modal")!;
    const deleteUserName = document.getElementById("delete-user-name")!;
    const deleteUserConfirmBtn = document.getElementById("delete-user-confirm-btn") as HTMLButtonElement;
    let pending删除UserId: string | null = null;

    function close删除UserModal() {
      deleteUserModal.classList.add("hidden");
      pending删除UserId = null;
    }

    usersBody.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".delete-user-btn") as HTMLButtonElement | null;
      if (!btn) return;
      pending删除UserId = btn.dataset.userId ?? null;
      deleteUserName.textContent = btn.dataset.username ?? "";
      deleteUserModal.classList.remove("hidden");
    });

    document.getElementById("delete-user-cancel-btn")?.addEventListener("click", close删除UserModal);
    document.getElementById("delete-user-modal-backdrop")?.addEventListener("click", close删除UserModal);

    deleteUserConfirmBtn?.addEventListener("click", async () => {
      if (!pending删除UserId) return;
      const userId = pending删除UserId;

      deleteUserConfirmBtn.disabled = true;
      try {
        const res = await fetch(`/api/settings/users/${userId}`, { method: "DELETE" });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not delete user";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        document.querySelector(`[data-user-row="${userId}"]`)?.remove();
        close删除UserModal();
      } catch (err: any) {
        showToast(err.message ?? "Could not delete user", "error");
        close删除UserModal();
      } finally {
        deleteUserConfirmBtn.disabled = false;
      }
    });
  </script>
</Layout>
